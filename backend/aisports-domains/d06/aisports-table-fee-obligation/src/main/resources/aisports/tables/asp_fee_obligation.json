{
  "name": "asp_fee_obligation",
  "domain": "D06",
  "description": "一次正式提交产生的付款义务。免费也记一笔，但不产生付款",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "registration_id",
      "type": "bigint",
      "description": "报名",
      "nullable": false,
      "default": null,
      "reference": "asp_registration",
      "check": null
    },
    {
      "name": "fee_policy_id",
      "type": "bigint",
      "description": "提交时的收费版本",
      "nullable": false,
      "default": null,
      "reference": "asp_fee_policy",
      "check": null
    },
    {
      "name": "total_amount",
      "type": "numeric(18,2)",
      "description": "当时解析出的整单金额。免费为 0；人民币元，不能用浮点",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "total_amount >= 0"
    },
    {
      "name": "currency",
      "type": "varchar(3)",
      "description": "币种。一期固定 CNY",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：not_required open settled void",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('not_required', 'open', 'settled', 'void')"
    },
    {
      "name": "quote_snapshot",
      "type": "jsonb",
      "description": "当次提交的整单金额、方式和说明；新快照rosterRevision记录当次实际冻结名单版本，历史缺值不回填或按顺序推定，展示原创建时间；统一收款含paymentSettings渠道及二维码文件编号快照，账户仅授权付款用途可见，不随配置改变；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "request_key",
      "type": "varchar(128)",
      "description": "义务幂等键。不复用报名请求键",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "declared_at",
      "type": "timestamptz",
      "description": "参赛者点击模拟付款完成的时间。不是到账确认；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "registration_id, request_key",
      null
    ],
    [
      "registration_id",
      "status IN ('not_required', 'open')"
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-fee-obligation",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
