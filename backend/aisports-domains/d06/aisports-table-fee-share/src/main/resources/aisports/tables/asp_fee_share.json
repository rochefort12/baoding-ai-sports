{
  "name": "asp_fee_share",
  "domain": "D06",
  "description": "经确认的承担者及代付范围",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "obligation_id",
      "type": "bigint",
      "description": "费用义务",
      "nullable": false,
      "default": null,
      "reference": "asp_fee_obligation",
      "check": null
    },
    {
      "name": "account_id",
      "type": "bigint",
      "description": "承担账号",
      "nullable": false,
      "default": null,
      "reference": "asp_account",
      "check": null
    },
    {
      "name": "person_id",
      "type": "bigint",
      "description": "对应选手",
      "nullable": true,
      "default": null,
      "reference": "asp_person",
      "check": null
    },
    {
      "name": "amount",
      "type": "numeric(18,2)",
      "description": "承担金额；人民币元，不能用浮点",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "amount >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：pending accepted cancelled",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('pending', 'accepted', 'cancelled')"
    },
    {
      "name": "accepted_at",
      "type": "timestamptz",
      "description": "分担确认；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
