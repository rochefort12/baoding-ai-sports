{
  "name": "asp_settlement",
  "domain": "D06",
  "description": "收款方或支付机构结算证据；记账不证明已结算",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "event_id",
      "type": "bigint",
      "description": "赛事",
      "nullable": false,
      "default": null,
      "reference": "asp_event",
      "check": null
    },
    {
      "name": "subject",
      "type": "varchar(200)",
      "description": "结算主体",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "due_amount",
      "type": "numeric(18,2)",
      "description": "应结算；人民币元，不能用浮点",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "due_amount >= 0"
    },
    {
      "name": "settled_amount",
      "type": "numeric(18,2)",
      "description": "已核实结算；人民币元，不能用浮点",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "settled_amount >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：pending partial completed failed disputed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('pending', 'partial', 'completed', 'failed', 'disputed')"
    },
    {
      "name": "evidence",
      "type": "jsonb",
      "description": "真实结算依据；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "reference",
      "type": "varchar(200)",
      "description": "结算唯一号",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [
    "settled_amount <= due_amount"
  ],
  "unique": [
    [
      "subject, reference",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-settlement",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
