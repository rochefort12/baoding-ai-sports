{
  "name": "asp_service_fee",
  "domain": "D06",
  "description": "平台服务收入依据；不能将报名流水认作平台收入",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "event_id",
      "type": "bigint",
      "description": "赛事",
      "nullable": false,
      "default": null,
      "reference": "asp_event",
      "check": null
    },
    {
      "name": "contract_reference",
      "type": "varchar(200)",
      "description": "真实服务及合同依据",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "calculation_basis",
      "type": "jsonb",
      "description": "固定额/基数/费率/税及退费政策；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "amount",
      "type": "numeric(18,2)",
      "description": "确认服务费；人民币元，不能用浮点",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "amount >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：calculated confirmed reversed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('calculated', 'confirmed', 'reversed')"
    },
    {
      "name": "confirmed_at",
      "type": "timestamptz",
      "description": "收入核对；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-service-fee",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
