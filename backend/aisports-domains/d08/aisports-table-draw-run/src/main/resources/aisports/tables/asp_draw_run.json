{
  "name": "asp_draw_run",
  "domain": "D08",
  "description": "抽签运行与可复核输入；不反复随机选择有利结果",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "stage_id",
      "type": "bigint",
      "description": "阶段",
      "nullable": false,
      "default": null,
      "reference": "asp_stage",
      "check": null
    },
    {
      "name": "rule_version_id",
      "type": "bigint",
      "description": "规则版本",
      "nullable": false,
      "default": null,
      "reference": "asp_rule_version",
      "check": null
    },
    {
      "name": "revision",
      "type": "integer",
      "description": "抽签版本",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "revision >= 0"
    },
    {
      "name": "input_snapshot",
      "type": "jsonb",
      "description": "有效名单版本、种子、轮空与回避依据；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "random_seed",
      "type": "varchar(200)",
      "description": "复核随机来源及种子",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "output_snapshot",
      "type": "jsonb",
      "description": "签位及约束检查；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：draft confirmed superseded failed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('draft', 'confirmed', 'superseded', 'failed')"
    },
    {
      "name": "reason",
      "type": "varchar(1000)",
      "description": "运行或重抽依据",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "stage_id, revision",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-draw-run",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
