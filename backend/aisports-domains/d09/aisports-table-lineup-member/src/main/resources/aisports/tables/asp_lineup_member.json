{
  "name": "asp_lineup_member",
  "domain": "D09",
  "description": "单场阵容及实际出场；不能从当前队伍直接拉人上场",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "match_entry_id",
      "type": "bigint",
      "description": "场次参赛单位",
      "nullable": false,
      "default": null,
      "reference": "asp_match_entry",
      "check": null
    },
    {
      "name": "roster_member_id",
      "type": "bigint",
      "description": "冻结赛事名单成员",
      "nullable": false,
      "default": null,
      "reference": "asp_roster_member",
      "check": null
    },
    {
      "name": "role",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：starter substitute",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "role IN ('starter', 'substitute')"
    },
    {
      "name": "position",
      "type": "integer",
      "description": "规程要求顺序",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": "position >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：planned confirmed replaced appeared",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('planned', 'confirmed', 'replaced', 'appeared')"
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "match_entry_id, roster_member_id",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-lineup-member",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
