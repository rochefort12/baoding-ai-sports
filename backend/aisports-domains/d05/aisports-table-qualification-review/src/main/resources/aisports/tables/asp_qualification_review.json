{
  "name": "asp_qualification_review",
  "domain": "D05",
  "description": "逐成员/整单审核记录；材料与到账不互相替代",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "registration_id",
      "type": "bigint",
      "description": "报名",
      "nullable": false,
      "default": null,
      "reference": "asp_registration",
      "check": null
    },
    {
      "name": "roster_member_id",
      "type": "bigint",
      "description": "审核成员；整单可为空",
      "nullable": true,
      "default": null,
      "reference": "asp_roster_member",
      "check": null
    },
    {
      "name": "decision",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：supplement approved rejected",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "decision IN ('supplement', 'approved', 'rejected')"
    },
    {
      "name": "basis",
      "type": "jsonb",
      "description": "所见名单/材料/费用及规则版本；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "reviewer_id",
      "type": "bigint",
      "description": "审核后台账号。无需审核的自动通过为空，不伪造人工审核人",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "reviewed_at",
      "type": "timestamptz",
      "description": "确认时间；有时区业务时间",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "reason",
      "type": "varchar(1000)",
      "description": "具体结论依据",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-qualification-review",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
