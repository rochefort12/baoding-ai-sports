{
  "name": "asp_registration_member",
  "domain": "D05",
  "description": "报名成员确认。按平台账号记录，提交成功后才抄入名单快照",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "registration_id",
      "type": "bigint",
      "description": "报名",
      "nullable": false,
      "default": null,
      "reference": "asp_registration",
      "check": null
    },
    {
      "name": "unit_id",
      "type": "bigint",
      "description": "竞赛单元。冗余，用于同一人同一单元只有一条有效报名",
      "nullable": false,
      "default": null,
      "reference": "asp_competition_unit",
      "check": null
    },
    {
      "name": "account_id",
      "type": "bigint",
      "description": "成员平台账号",
      "nullable": false,
      "default": null,
      "reference": "asp_account",
      "check": null
    },
    {
      "name": "person_id",
      "type": "bigint",
      "description": "确认时的本人档案。待确认时可空",
      "nullable": true,
      "default": null,
      "reference": "asp_person",
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：pending_confirmation confirmed declined",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('pending_confirmation', 'confirmed', 'declined')"
    },
    {
      "name": "self_member",
      "type": "boolean",
      "description": "true 表示报名提交人本人",
      "nullable": false,
      "default": "false",
      "reference": null,
      "check": null
    },
    {
      "name": "invite_token",
      "type": "varchar(64)",
      "description": "邀请确认令牌。本人成员为空",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "person_snapshot",
      "type": "jsonb",
      "description": "确认时抄下的档案。提交名单时使用，之后改档案不回写；必须按版本校验结构",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "occupying",
      "type": "boolean",
      "description": "true 表示这条成员正在占用该单元的有效报名",
      "nullable": false,
      "default": "false",
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [
    "occupying = false OR status = 'confirmed'"
  ],
  "unique": [
    [
      "registration_id, account_id",
      null
    ],
    [
      "unit_id, account_id",
      "occupying = true"
    ],
    [
      "invite_token",
      "invite_token IS NOT NULL"
    ]
  ],
  "responsibility": "邀请确认不是长期队伍邀请。已提交或已通过的成员才把 occupying 设为 true。",
  "moduleId": "aisports-table-registration-member",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
