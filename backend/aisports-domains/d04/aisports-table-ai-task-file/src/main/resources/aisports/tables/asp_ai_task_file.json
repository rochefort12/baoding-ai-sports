{
  "name": "asp_ai_task_file",
  "domain": "D04",
  "description": "AI 任务附件引用。文件本体在对象存储，用途必须是 ai-source，不能借用收款码",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "task_id",
      "type": "bigint",
      "description": "所属任务",
      "nullable": false,
      "default": null,
      "reference": "asp_ai_task",
      "check": null
    },
    {
      "name": "file_id",
      "type": "bigint",
      "description": "asp_file 编号。文件表无租户列，这里不建外键",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "sort_order",
      "type": "integer",
      "description": "同一任务内从 0 开始的顺序",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "sort_order >= 0"
    },
    {
      "name": "media_kind",
      "type": "varchar(32)",
      "description": "嗅探后的类型：docx xlsx pdf-text pdf-scan jpeg png webp",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "original_name",
      "type": "varchar(200)",
      "description": "上传时的文件名，只用于展示",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "page_count",
      "type": "integer",
      "description": "PDF 页数。其他类型为空",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": "page_count >= 0"
    }
  ],
  "tenant": true,
  "checks": [
    "media_kind IN ('docx', 'xlsx', 'pdf-text', 'pdf-scan', 'jpeg', 'png', 'webp')"
  ],
  "unique": [
    [
      "task_id, sort_order",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-ai-task-file",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
