{
  "name": "asp_org_field",
  "domain": "D04",
  "description": "组织自有的参赛采集字段。未选用可停用；选用后不改类型和选项含义",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "organization_id",
      "type": "bigint",
      "description": "维护这个目录的组织",
      "nullable": false,
      "default": null,
      "reference": "asp_organization",
      "check": null
    },
    {
      "name": "code",
      "type": "varchar(64)",
      "description": "组织内稳定编码",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "label",
      "type": "varchar(100)",
      "description": "显示名称",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "value_type",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：text number date enum",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "value_type IN ('text', 'number', 'date', 'enum')"
    },
    {
      "name": "options",
      "type": "jsonb",
      "description": "单选枚举的选项。其他类型为空数组；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：active stopped",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('active', 'stopped')"
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "organization_id, code",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-org-field",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
