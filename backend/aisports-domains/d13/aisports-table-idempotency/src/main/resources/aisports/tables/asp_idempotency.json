{
  "name": "asp_idempotency",
  "domain": "D13",
  "description": "请求去重及不确定响应恢复；不得只靠页面按钮防重",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "account_id",
      "type": "bigint",
      "description": "调用者",
      "nullable": false,
      "default": null,
      "reference": "asp_account",
      "check": null
    },
    {
      "name": "operation",
      "type": "varchar(100)",
      "description": "动作",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "request_key",
      "type": "varchar(128)",
      "description": "客户端重试键",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "payload_hash",
      "type": "varchar(128)",
      "description": "输入摘要；同键不同输入拒绝",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：processing completed failed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('processing', 'completed', 'failed')"
    },
    {
      "name": "result_reference",
      "type": "jsonb",
      "description": "原业务结果引用；不存敏感完整响应；必须按版本校验结构",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "expires_at",
      "type": "timestamptz",
      "description": "去重记录保留截止；有时区业务时间",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "account_id, operation, request_key",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-idempotency",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
