{
  "name": "asp_complaint",
  "domain": "D13",
  "description": "平台投诉、反馈及分派；专业结果争议移交申诉",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "applicant_account_id",
      "type": "bigint",
      "description": "投诉人",
      "nullable": false,
      "default": null,
      "reference": "asp_account",
      "check": null
    },
    {
      "name": "object_type",
      "type": "varchar(100)",
      "description": "组织/赛事/队伍/付款/资料",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "object_id",
      "type": "bigint",
      "description": "关联对象",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "request",
      "type": "varchar(2000)",
      "description": "诉求",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "evidence",
      "type": "jsonb",
      "description": "最小披露证据；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：submitted accepted investigating resolved rejected appealed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('submitted', 'accepted', 'investigating', 'resolved', 'rejected', 'appealed')"
    },
    {
      "name": "owner_id",
      "type": "bigint",
      "description": "处理责任人",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "resolution",
      "type": "jsonb",
      "description": "处理及告知；必须按版本校验结构",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-complaint",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
