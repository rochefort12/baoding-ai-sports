{
  "name": "asp_migration_batch",
  "domain": "D13",
  "description": "旧系统来源、授权及数量金额差异核对",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "source_system",
      "type": "varchar(100)",
      "description": "来源系统",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "source_version",
      "type": "varchar(100)",
      "description": "导出及切换版本",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "authorization_snapshot",
      "type": "jsonb",
      "description": "迁移范围及接收责任；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "reconciliation",
      "type": "jsonb",
      "description": "身份、名单、金额、退款、赛程及结果汇总；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：importing checking verified blocked cutover rolled_back",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('importing', 'checking', 'verified', 'blocked', 'cutover', 'rolled_back')"
    },
    {
      "name": "cutover_at",
      "type": "timestamptz",
      "description": "唯一生效切换时间；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-migration-batch",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
