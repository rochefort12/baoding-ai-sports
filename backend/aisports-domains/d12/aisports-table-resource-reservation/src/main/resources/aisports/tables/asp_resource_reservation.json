{
  "name": "asp_resource_reservation",
  "domain": "D12",
  "description": "赛事资源使用确认；不冒充商业预约交易",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "resource_id",
      "type": "bigint",
      "description": "具体资源",
      "nullable": false,
      "default": null,
      "reference": "asp_resource",
      "check": null
    },
    {
      "name": "event_id",
      "type": "bigint",
      "description": "赛事",
      "nullable": false,
      "default": null,
      "reference": "asp_event",
      "check": null
    },
    {
      "name": "starts_at",
      "type": "timestamptz",
      "description": "使用开始；有时区业务时间",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "ends_at",
      "type": "timestamptz",
      "description": "使用结束；有时区业务时间",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "quantity",
      "type": "integer",
      "description": "占用容量",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "quantity >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：requested confirmed cancelled",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('requested', 'confirmed', 'cancelled')"
    },
    {
      "name": "confirmation",
      "type": "jsonb",
      "description": "场地方和赛事方确认依据；必须按版本校验结构",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [
    "ends_at > starts_at",
    "quantity > 0"
  ],
  "unique": [],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-resource-reservation",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
