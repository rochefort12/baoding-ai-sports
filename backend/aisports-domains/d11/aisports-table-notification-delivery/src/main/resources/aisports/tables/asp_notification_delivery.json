{
  "name": "asp_notification_delivery",
  "domain": "D11",
  "description": "逐渠道发送和送达结果；失败需责任人跟进",
  "columns": [
    {
      "name": "id",
      "type": "bigint",
      "description": "稳定编号"
    },
    {
      "name": "tenant_id",
      "type": "varchar(20)",
      "description": "组织管理范围"
    },
    {
      "name": "notification_id",
      "type": "bigint",
      "description": "通知",
      "nullable": false,
      "default": null,
      "reference": "asp_notification",
      "check": null
    },
    {
      "name": "channel",
      "type": "varchar(100)",
      "description": "站内/短信/小程序等",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "attempt",
      "type": "integer",
      "description": "尝试次数",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "attempt >= 0"
    },
    {
      "name": "status",
      "type": "varchar(32)",
      "description": "独立业务状态；合法值不等于业务已获批准：pending sent delivered failed",
      "nullable": false,
      "default": null,
      "reference": null,
      "check": "status IN ('pending', 'sent', 'delivered', 'failed')"
    },
    {
      "name": "channel_reference",
      "type": "varchar(200)",
      "description": "渠道回执",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "sent_at",
      "type": "timestamptz",
      "description": "发送；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "delivered_at",
      "type": "timestamptz",
      "description": "送达；有时区业务时间",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    },
    {
      "name": "failure_reason",
      "type": "varchar(1000)",
      "description": "失败原因",
      "nullable": true,
      "default": null,
      "reference": null,
      "check": null
    }
  ],
  "tenant": true,
  "checks": [],
  "unique": [
    [
      "notification_id, channel, attempt",
      null
    ]
  ],
  "responsibility": "应用服务执行状态转换、授权和跨记录一致性，数据库约束只是结构防线。",
  "moduleId": "aisports-table-notification-delivery",
  "lifecycle": "schema",
  "genericWrites": false,
  "queryOpen": false
}
