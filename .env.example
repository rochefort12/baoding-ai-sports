# Run scripts/Initialize-Environment.ps1 to create a private .env with random secrets.
COMPOSE_PROJECT_NAME=aisports-dev
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:639ab7ceb90e13123085b741fb31ef493fba25463002f6da665352e7b534b652
REDIS_IMAGE=redis:7.4.11-bookworm@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f
POSTGRES_DB=aisports
POSTGRES_USER=aisports_owner
POSTGRES_PASSWORD=GENERATE_LOCALLY
APP_DB_USER=aisports_app
APP_DB_PASSWORD=GENERATE_LOCALLY
POSTGRES_PORT=25432
REDIS_PORT=26379
REDIS_PASSWORD=GENERATE_LOCALLY
JWT_SECRET=GENERATE_LOCALLY
MONITOR_PASSWORD=GENERATE_LOCALLY
MCP_ENABLED=false
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_EKEY=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_SCENE_NAME=
ALIYUN_CAPTCHA_MODE=traceless
ALIYUN_CAPTCHA_CLIENT=web
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
# 从资料创建赛事。密钥留空时不请求模型。
# 密钥仅供服务端使用。DASHSCOPE_API_KEY 保留为历史兼容变量，新配置使用 DEEPSEEK_API_KEY。
# deepseek-flash 是 DeepSeek-V4.1-Flash 的正式模型 ID。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
AI_COMPAT_BASE_URL=https://api.deepseek.com
AI_TEXT_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash
AI_GATEWAY_PORT=8091
AI_GATEWAY_URL=http://127.0.0.1:8091
AI_INTERNAL_TOKEN=
AI_MAX_SCAN_PAGES=15
AI_DAILY_TASK_LIMIT=20
AI_OPS_SESSION_LIMIT=8
# 宣传画面的生图密钥。留空时不请求图像接口，海报使用赛事宣传图或固定插画。
AI_IMAGE_API_KEY=
AI_IMAGE_PROVIDER=volcengine
# 图像能力独立配置；不复用聊天密钥。兼容 images/generations、返回 base64 的 HTTPS 端点。
AI_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
AI_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_RESPONSE_FORMAT=
# 腾讯云注册短信：仅服务端使用。当前模板参数按验证码、有效分钟数排列。
TENCENT_SMS_ENABLED=false
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN=
TENCENT_SMS_TEMPLATE_ID=
PARTICIPANT_SMS_ECHO_CODE=false
