# Copy to /opt/aisports/config/backend.env. Generate independent ECS secrets.
DB_JDBC_URL=jdbc:postgresql://postgres:5432/aisports?reWriteBatchedInserts=true
POSTGRES_USER=aisports_owner
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_OWNER_PASSWORD
APP_DB_USER=aisports_app
APP_DB_PASSWORD=REPLACE_WITH_APPLICATION_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
MONITOR_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PARTICIPANT_PHONE_PEPPER=REPLACE_WITH_STABLE_RANDOM_SECRET
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m -XX:+UseG1GC -Djava.awt.headless=true -Dfile.encoding=UTF-8
MCP_ENABLED=false
PARTICIPANT_SMS_ECHO_CODE=false
TENCENT_SMS_ENABLED=false
# Configure SMS/captcha/provider variables from .env.example as needed, on ECS only.
DEEPSEEK_API_KEY=
AI_INTERNAL_TOKEN=REPLACE_WITH_SHARED_RANDOM_GATEWAY_TOKEN
